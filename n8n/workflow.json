{
  "name": "Academia Lumina - Customer Support RAG Router & Telegram Escalation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "chat",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "id": "webhook-trigger",
      "name": "Webhook - Recepción de Consulta"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/chat",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.BACKEND_API_KEY || 'lumina_dev_api_key_2026' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"message\": \"{{ $json.body.message }}\",\n  \"session_id\": \"{{ $json.body.session_id || 'n8n_session' }}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        480,
        300
      ],
      "id": "fastapi-rag-request",
      "name": "HTTP Request - Router FastAPI RAG"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.is_escalated }}",
              "value2": true
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        700,
        300
      ],
      "id": "if-escalated-check",
      "name": "¿Requiere Escalamiento?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot8856257947:AAF3buxaPS5fSmBQWPY0IG6GCjwPEdR_oyU/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"7761516818\",\n  \"text\": \"⚠️ <b>ALERTA DE ESCALAMIENTO N8N — ACADEMIA LUMINA</b>\\n\\n🆔 <b>ID Sesión:</b> <code>\" + $json.session_id + \"</code>\\n🤖 <b>Respuesta Bot:</b>\\n<i>\" + $json.response + \"</i>\\n\\n📲 <b>Enlace WhatsApp:</b> \" + ($json.whatsapp_link || 'No generado') + \"\\n\\n⚡ <i>Atención inmediata requerida.</i>\",\n  \"parse_mode\": \"HTML\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        920,
        200
      ],
      "id": "telegram-notification-node",
      "name": "Notificación Telegram Admisiones"
    },
    {
      "parameters": {
        "options": {},
        "respondWith": "json",
        "responseBody": "={\n  \"response\": \"{{ $json.response }}\",\n  \"is_escalated\": {{ $json.is_escalated }},\n  \"whatsapp_link\": \"{{ $json.whatsapp_link || '' }}\",\n  \"session_id\": \"{{ $json.session_id }}\"\n}"
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        920,
        420
      ],
      "id": "respond-to-webhook",
      "name": "Respuesta al Cliente"
    }
  ],
  "connections": {
    "Webhook - Recepción de Consulta": {
      "main": [
        [
          {
            "node": "HTTP Request - Router FastAPI RAG",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request - Router FastAPI RAG": {
      "main": [
        [
          {
            "node": "¿Requiere Escalamiento?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Requiere Escalamiento?": {
      "main": [
        [
          {
            "node": "Notificación Telegram Admisiones",
            "type": "main",
            "index": 0
          },
          {
            "node": "Respuesta al Cliente",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respuesta al Cliente",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notificación Telegram Admisiones": {
      "main": [
        []
      ]
    }
  },
  "settings": {}
}
