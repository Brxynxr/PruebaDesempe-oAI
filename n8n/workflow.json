{
  "id": "P3ySUHQ5KdBqlMFE",
  "name": "Academia Lumina - Customer Support RAG Router & Telegram Escalation",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "chat",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "id": "webhook-trigger",
      "name": "Webhook - Recepción de Consulta",
      "webhookId": "chat"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/chat",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.BACKEND_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: ($json.body && $json.body.message) ? $json.body.message : ($json.message || ''), session_id: ($json.body && $json.body.session_id) ? $json.body.session_id : ($json.session_id || ('n8n_' + Math.random().toString(36).substring(2, 9))), language: ($json.body && $json.body.language) ? $json.body.language : ($json.language || 'es') }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        480,
        300
      ],
      "id": "fastapi-rag-request",
      "name": "HTTP Request - Router FastAPI RAG"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.is_escalated }}",
              "value2": true
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        720,
        300
      ],
      "id": "if-escalated-check",
      "name": "¿Requiere Escalamiento?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: '{{ $env.TELEGRAM_CHAT_ID }}', text: '🚨 <b>SOLICITUD DE ATENCIÓN HUMANA — LUMINA AI</b>\\n\\n🆔 <b>ID de Sesión:</b> <code>' + ($json.session_id || 'N/A') + '</code>\\n\\n📝 <b>Detalle del Caso:</b>\\n<i>« ' + (($json.response || '').length > 280 ? ($json.response || '').substring(0, 277) + '...' : ($json.response || 'Solicitud de escalamiento recibida')) + ' »</i>\\n\\n🔔 <i>Prioridad: Alta • Atención requerida por asesor.</i>', parse_mode: 'HTML', reply_markup: { inline_keyboard: [ [ { text: '📲 Abrir WhatsApp', url: ($json.whatsapp_link || 'https://wa.me/573000000000') } ], [ { text: '🙋‍♂️ Tomar Caso', callback_data: 'claim:' + ($json.session_id || 'default') }, { text: '✅ Caso Resuelto', callback_data: 'resolve:' + ($json.session_id || 'default') } ] ] } }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        960,
        200
      ],
      "id": "telegram-notification-node",
      "name": "Notificación Telegram Admisiones"
    },
    {
      "parameters": {
        "respondWith": "firstIncomingItem",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        960,
        420
      ],
      "id": "respond-to-webhook",
      "name": "Respuesta al Cliente"
    }
  ],
  "connections": {
