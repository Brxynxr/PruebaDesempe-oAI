{
  "name": "Academia Lumina - Monitor de SLA y Alertas Telegram",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "cronExpression": "*/5 * * * *"
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ],
      "id": "schedule-trigger-sla",
      "name": "Cada 5 Minutos"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://backend:8000/api/v1/admin/conversations/sla/breached?threshold_minutes=10",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.BACKEND_API_KEY || 'lumina_dev_api_key_2026' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        480,
        300
      ],
      "id": "http-get-sla-breached",
      "name": "Consultar SLA Breached en Backend"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst rawData = items.map(i => i.json);\nconst count = Array.isArray(rawData) ? rawData.length : (rawData.id ? 1 : 0);\n\nreturn [{\n  json: {\n    count: count,\n    breached_conversations: rawData,\n    threshold_minutes: 10\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ],
      "id": "code-count-sla",
      "name": "Evaluar Cola de Espera"
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.count }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        920,
        300
      ],
      "id": "if-sla-breached",
      "name": "¿Hay Leads en Riesgo (>10 min)?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot8856257947:AAF3buxaPS5fSmBQWPY0IG6GCjwPEdR_oyU/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"7761516818\",\n  \"text\": \"🚨 <b>ALERTA CRÍTICA DE SLA N8N (>10 MIN) — ACADEMIA LUMINA</b>\\n\\n⚠️ Se han detectado <b>\" + $json.count + \"</b> conversación(es) esperando atención por más de 10 minutos.\\n\\n👉 Por favor ingresar de inmediato al panel o responder en Telegram:\\nhttp://localhost:3000/admin/login\",\n  \"parse_mode\": \"HTML\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        1140,
        250
      ],
      "id": "telegram-sla-alert",
      "name": "Enviar Alerta SLA a Telegram"
    }
  ],
  "connections": {
    "Cada 5 Minutos": {
      "main": [
        [
          {
            "node": "Consultar SLA Breached en Backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Consultar SLA Breached en Backend": {
      "main": [
        [
          {
            "node": "Evaluar Cola de Espera",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evaluar Cola de Espera": {
      "main": [
        [
          {
            "node": "¿Hay Leads en Riesgo (>10 min)?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Hay Leads en Riesgo (>10 min)?": {
      "main": [
        [
          {
            "node": "Enviar Alerta SLA a Telegram",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Enviar Alerta SLA a Telegram": {
      "main": [
        []
      ]
    }
  },
  "settings": {}
}
