{
  "name": "Academia Lumina - Reporte Diario Telegram y Desempeño RAG",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "cronExpression": "0 8 * * *"
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ],
      "id": "schedule-trigger-daily-8am",
      "name": "Diario a las 8:00 AM"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://backend:8000/api/v1/metrics",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.BACKEND_API_KEY || 'lumina_dev_api_key_2026' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        480,
        300
      ],
      "id": "http-get-metrics",
      "name": "Obtener Métricas del Backend"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot8856257947:AAF3buxaPS5fSmBQWPY0IG6GCjwPEdR_oyU/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"7761516818\",\n  \"text\": \"📊 <b>REPORTE DIARIO DE OPERACIONES N8N — ACADEMIA LUMINA</b>\\n\\n📈 <b>Total Consultas:</b> \" + $json.total_queries + \"\\n⚡ <b>Tasa Caché Semántico:</b> \" + $json.cache_hit_rate_percentage + \"\\n⚠️ <b>Tasa Escalamiento:</b> \" + $json.escalation_rate_percentage + \"\\n🔢 <b>Tokens Consumidos:</b> \" + $json.total_tokens + \"\\n💵 <b>Costo Estimado:</b> \" + $json.estimated_cost_usd + \"\\n\\n<i>Generado automáticamente a las 8:00 AM por n8n.</i>\",\n  \"parse_mode\": \"HTML\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        720,
        300
      ],
      "id": "telegram-daily-report",
      "name": "Enviar Reporte a Telegram"
    }
  ],
  "connections": {
    "Diario a las 8:00 AM": {
      "main": [
        [
          {
            "node": "Obtener Métricas del Backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Obtener Métricas del Backend": {
      "main": [
        [
          {
            "node": "Enviar Reporte a Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar Reporte a Telegram": {
      "main": [
        []
      ]
    }
  },
  "settings": {}
}
