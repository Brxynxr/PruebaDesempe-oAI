# =============================================================================
# ACADEMIA LUMINA — BACKEND ENVIRONMENT VARIABLES
# =============================================================================

# Execution Environment (development / production)
ENVIRONMENT=development

# Database Connection URL (Leave empty for SQLite in dev; use Render Postgres URL in production)
# PostgreSQL Example: postgresql://lumina_user:password@dpg-xxx.render.com/lumina_db
DATABASE_URL=

# Groq API Key for LLM Inference (Obtain from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API Key for Multilingual Vector Embeddings (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Internal API Key to authenticate Frontend <-> Backend requests (Must match VITE_BACKEND_API_KEY)
BACKEND_API_KEY=your_secure_random_api_key_here

# Admin Backoffice Authentication & JWT Settings
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password_here
JWT_SECRET_KEY=your_secure_jwt_random_secret_string_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Rate Limiting per Client IP (Cybersecurity)
RATE_LIMIT_PER_MINUTE=60/minute

# Server Port
PORT=8000

# Allowed CORS Origins (Comma-separated URL list. In Render: https://your-frontend.onrender.com)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# Storage directory for ChromaDB vector embeddings
CHROMA_DB_DIR=./chroma_data

# Admissions Advisor Contact & Escalation Parameters
ADVISOR_NAME=Admissions Advisor
WHATSAPP_NUMBER=+57 300 000 0000
WHATSAPP_URL=https://wa.me/573000000000
ESCALATION_EMAIL=admissions@academialumina.edu.co

# Telegram Omnichannel Escalation Bot
TELEGRAM_BOT_TOKEN=your_new_telegram_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_or_group_id
