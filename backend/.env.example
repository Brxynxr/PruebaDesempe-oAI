# Groq API Key for LLM Inference (Obtain from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API Key for Multilingual Vector Embeddings (Obtain from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Secret API Key to authenticate incoming requests from Frontend / Automation (Must match VITE_BACKEND_API_KEY)
BACKEND_API_KEY=your_secure_random_api_key_here

# Execution Environment (development / production)
ENVIRONMENT=development

# Storage directory for ChromaDB vector embeddings
CHROMA_DB_DIR=./chroma_data

# Rate Limiting per Client IP (Cybersecurity)
RATE_LIMIT_PER_MINUTE=10/minute

# Server Port
PORT=8000

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# Admissions Advisor Contact & Escalation Parameters
ADVISOR_NAME=Admissions Advisor
WHATSAPP_NUMBER=+57 300 000 0000
WHATSAPP_URL=https://wa.me/573000000000
ESCALATION_EMAIL=admissions@academialumina.edu.co

# SMTP Server configuration for lead notification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_USE_TLS=true
SMTP_SENDER_EMAIL=your_email@gmail.com

# Telegram Omnichannel Escalation Bot (Optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_or_group_id
