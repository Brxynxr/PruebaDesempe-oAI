# API Key de Groq para acceder al modelo Llama 3.3 70B
GROQ_API_KEY=gsk_your_groq_api_key_here

# Clave secreta para autenticar las peticiones entrantes desde n8n / frontend al backend
BACKEND_API_KEY=lumina_secret_key_2026

# Nombre del entorno (development / production)
ENVIRONMENT=development

# Ruta de almacenamiento persistente para la base vectorial ChromaDB
CHROMA_DB_DIR=./chroma_data

# Límite de peticiones por minuto por IP (Seguridad)
RATE_LIMIT_PER_MINUTE=10/minute

# Puerto de ejecución de FastAPI
PORT=8000

# Configuración del servidor SMTP para el envío real de correos de escalamiento
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password_o_clave_smtp
SMTP_USE_TLS=true
SMTP_SENDER_EMAIL=tu_correo@gmail.com
